{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ManifestMigrationLedger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "total_canonical_manifests",
    "total_source_files",
    "canonical_pass_min",
    "canonical_pass_max",
    "migration_records"
  ],
  "properties": {
    "total_canonical_manifests": { "type": "integer", "minimum": 0 },
    "total_source_files": { "type": "integer", "minimum": 0 },
    "canonical_pass_min": { "type": ["integer", "null"] },
    "canonical_pass_max": { "type": ["integer", "null"] },
    "migration_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "original_source_path",
          "source_path",
          "source_filename",
          "source_sha256",
          "detected_schema",
          "parsed_pass",
          "canonical_target_filename",
          "canonical_pass",
          "range_count",
          "disposition"
        ],
        "properties": {
          "original_source_path": { "type": "string", "minLength": 1 },
          "source_path": { "type": "string" },
          "source_filename": { "type": "string" },
          "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "detected_schema": { "type": "string" },
          "parsed_pass": { "type": ["integer", "null"] },
          "canonical_target_filename": { "type": ["string", "null"] },
          "canonical_pass": { "type": ["integer", "null"] },
          "range_count": { "type": "integer", "minimum": 0 },
          "disposition": { "type": "string", "enum": ["canonicalized", "merged", "superseded", "quarantined", "archived", "scan_report_without_closed_ranges"] },
          "legacy_archived_path": { "type": "string" }
        }
      }
    }
  }
}
