{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReportProvenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_commit",
    "source_tree",
    "worktree_clean_before_generation",
    "manifest_set_digest",
    "generator",
    "generation_command",
    "generated_at_utc",
    "report_schema_version"
  ],
  "properties": {
    "source_commit": { "type": "string" },
    "source_tree": { "type": "string" },
    "worktree_clean_before_generation": { "type": "boolean" },
    "manifest_set_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generator": { "type": "string" },
    "generator_source_digest": { "type": "string" },
    "generation_command": { "type": "string" },
    "generated_at_utc": { "type": "string" },
    "report_schema_version": { "type": "integer" }
  }
}
