{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CandidateDispositionLedger",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "source_commit", "description", "candidate_count", "candidates"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "description": { "type": "string", "minLength": 20 },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "address", "region", "disposition", "reason", "review_date", "evidence", "unresolved_requirements"],
        "properties": {
          "candidate_id": { "type": "string", "pattern": "^cand_[a-z0-9_]+$" },
          "address": { "type": "string", "pattern": "^[A-F0-9]{2}:[A-F0-9]{4}$" },
          "region": { "type": "string", "pattern": "^[A-F0-9]{2}:[A-F0-9]{4}\\.\\.[A-F0-9]{2}:[A-F0-9]{4}$" },
          "score": { "type": ["integer", "null"], "minimum": 0 },
          "disposition": { "enum": ["accepted", "rejected", "deferred", "already_covered", "reclassified_data", "reclassified_fragment"] },
          "reason": { "type": "string", "minLength": 40 },
          "review_date": { "type": "string", "format": "date" },
          "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "related_manifests": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^passes/manifests/pass[0-9]{4}\\.json$" } },
          "unresolved_requirements": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    }
  }
}
